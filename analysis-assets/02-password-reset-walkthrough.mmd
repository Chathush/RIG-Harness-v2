flowchart TB
    req["REQUIREMENT<br/>Reset a forgotten password by email"]:::human
    architect["ARCHITECT · /rig:chart<br/>Split into small intents"]:::agent

    i1["I1 · ISSUE TOKEN<br/>Create a one-time token<br/>with an expiry"]:::flow
    i2["I2 · VALIDATE TOKEN<br/>Check token and<br/>change password"]:::focus
    i3["I3 · EMAIL + SCREEN<br/>Send reset link<br/>and show reset form"]:::flow

    zoom["ZOOM INTO I2<br/>Define observable behaviours"]:::flow

    b1["B1 · VALID TOKEN<br/>Password changes<br/>successfully"]:::agent
    b2["B2 · EXPIRED TOKEN<br/>Reject reset;<br/>password unchanged"]:::focus
    b3["B3 · USED TOKEN<br/>Reject reuse;<br/>password unchanged"]:::agent

    qa["ZOOM INTO B2<br/>QA · /rig:testplan<br/>Describe cases and synthetic data"]:::check
    tc1["TC2a · REJECTION<br/>Try an expired token<br/>Expect reset to be refused"]:::check
    tc2["TC2b · NO SIDE EFFECT<br/>Try an expired token<br/>Expect original password hash"]:::check

    approval(["PERSON APPROVES<br/>Chart and the selected change's plan"]):::human
    script["BUILDER · /rig:build<br/>Write reset-token.test.ts<br/>Assert rejection AND unchanged hash"]:::check
    red["RED · RUN TEST FIRST<br/>Capture failure caused by<br/>the missing expiry check"]:::fail
    implement["IMPLEMENT<br/>Add expiry validation<br/>and failure handling"]:::agent
    green["GREEN · RERUN TEST<br/>Both expectations now pass"]:::pass

