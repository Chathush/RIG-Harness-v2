flowchart LR
    subgraph sprint["OPTIONAL SPRINT LOOP · /rig:chart + /rig:testplan"]
        direction TB
        prd["Person's PRD"]:::human
        preserve["Preserve original<br/>Normalize and map if needed"]:::flow
        ledger["Requirements ledger<br/>Resolve design questions"]:::data
        architect["Architect<br/>Intents, architecture, ADRs,<br/>implementation plan"]:::agent
        qa["QA<br/>Test plan, written cases,<br/>synthetic fixture files"]:::agent
        review["Script checks +<br/>independent chart review"]:::check
        chartApproval{"Human approves chart"}:::human
        prd --> preserve --> ledger --> architect --> qa --> review --> chartApproval
    end
    subgraph change["PER-CHANGE LOOP · one ready intent or an ad-hoc task"]
        direction TB
        start["/rig:start<br/>intent.md + spec.md<br/>B1, B2, B3..."]:::flow
        plan["/rig:plan<br/>Files, interfaces and tests"]:::flow
        approve{"Human approves<br/>Hash spec / plan<br/>Freeze contracts"}:::human
        build["/rig:build<br/>Test before implementation<br/>for each behaviour"]:::agent
        verify["/rig:test<br/>Broad verification<br/>verify.json"]:::check
        pr["/rig:pr<br/>Review, fixes,<br/>fresh verification, PR"]:::flow
        start --> plan --> approve --> build --> verify --> pr
    end
    adhoc["Ad-hoc task<br/>No sprint required"]:::human
    sprint -->|Choose a ready intent| change
    adhoc --> change
