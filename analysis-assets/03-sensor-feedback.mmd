    edit["BUILDER edits a file<br/>Example: changes the password-reset test"]:::agent
    hook["HOOK notices the event<br/>After an edit: invoke checking script"]:::flow
    script["SCRIPT selects the checks due<br/>Uses sensor registry and event / model policy"]:::flow
    checks["SENSORS inspect the work<br/>Test tampering · secrets · layer rules<br/>Configured lint · types · tests"]:::check
    decision{"Blocking issue found?"}:::check
    fix["YES · Report a concrete finding<br/>Builder fixes the code and retries"]:::fail
    proceed["NO · Continue<br/>Broader checks at verification and CI"]:::pass
